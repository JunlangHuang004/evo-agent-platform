# Copy to .env and fill in the Canvas course key. Never commit .env.
LLM_PROVIDER=hkgai
LLM_BASE_URL=https://api1.hkgai.net/v1
LLM_MODEL=t2_hkgai-v3_fp8_1m_e7
LLM_API_KEY=
PORT=8080
MODEL_TIMEOUT=90
MODEL_MAX_TOKENS=400
DOCKER_IMAGE=python:3.11-alpine
MAX_MODEL_CALLS=28
MAX_AGENT_TURNS=8
MAX_RUN_TOKENS=48000
MAX_RUN_SECONDS=600
MAX_TASKS=12
MAX_DELEGATION_DEPTH=3
PARALLEL_TASKS=2
MAX_RETRIES=2
APPROVAL_TTL_SECONDS=900

# Optional fixed remote for Agent git.push. Does NOT authorize a push by itself.
GIT_REMOTE=
GIT_TOKEN=
GIT_USERNAME=x-access-token

# Other course-approved provider (set provider, URL, model and key together):
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
