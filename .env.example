# Copy to .env and fill in the Canvas course key. Never commit .env.
LLM_PROVIDER=hkgai
LLM_BASE_URL=https://api1.hkgai.net/v1
LLM_MODEL=t2_hkgai-v3_fp8_1m_e7
LLM_API_KEY=
# Validated local course profile; preserves proxy routing and TLS verification.
# Use standard on networks that do not need paced HTTPS writes.
LLM_TRANSPORT_MODE=compatible
# Verified for the configured HKGAI model. Use default when selecting DeepSeek.
LLM_THINKING_MODE=disabled
# Only planning/actions use this verified HKGAI JSON mode; ordinary chat stays text.
LLM_JSON_MODE=json_object
PORT=8080
MODEL_TIMEOUT=120
MODEL_MAX_TOKENS=6000
# Planning uses the smaller of this value and MODEL_MAX_TOKENS.
PLANNING_MAX_TOKENS=3000
DOCKER_IMAGE=python:3.11-alpine
# JavaScript/Node and offline Chromium tests; build docker/browser once on each machine.
# docker build -t evo-agent-browser:1.64.1 docker/browser
BROWSER_IMAGE=evo-agent-browser:1.64.1
MAX_MODEL_CALLS=28
MAX_AGENT_TURNS=8
MAX_RUN_TOKENS=48000
MAX_RUN_SECONDS=600
MAX_TASKS=12
MAX_DELEGATION_DEPTH=3
PARALLEL_TASKS=2
MAX_RETRIES=1
# Time-only mode: retry only incomplete text generation (0..3); not whole tasks/tools.
MODEL_GENERATION_RETRIES=2
APPROVAL_TTL_SECONDS=900

# Optional fixed remote for Agent git.push. Does NOT authorize a push by itself.
GIT_REMOTE=
GIT_TOKEN=
GIT_USERNAME=x-access-token

# Other course-approved provider (set provider, URL, model and key together):
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_THINKING_MODE=default
# LLM_JSON_MODE=default
